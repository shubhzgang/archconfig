/* Thumbnail grid for hypr/wallpaper.sh: no search bar, one card per wallpaper. */
@import "~/.config/rofi/theme.rasi"
@import "~/.config/rofi/card.rasi"

window { width: 3000px; height: 1500px; }

mainbox { children: [ listview ]; }

listview {
    columns: 12;
    fixed-columns: true;
    lines: 8;
}

element {
    orientation: vertical;
    /* 240x174 cell: 7px card-shadow margin + 15px of card space on every side of the
       196x130 thumbnail (see make-cards.py). The icon box is square, so a negative vertical
       margin trims it to the thumbnail's 130px height. */
    padding: 22px 22px;
    background-image: url("/home/shubham/.cache/wal/rofi-card-wall.png", both);
}

element selected {
    padding: 16px 22px 28px 22px;  /* content moves up 6px with the lifted card */
    background-image: url("/home/shubham/.cache/wal/rofi-card-wall-sel.png", both);
}

element-icon { size: 196px; margin: -33px 0px; horizontal-align: 0.5; }
element-text { enabled: false; }
