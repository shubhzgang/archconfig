/* Thumbnail grid for hypr/wallpaper.sh: no search bar, one card per wallpaper. */
@import "~/.config/rofi/theme.rasi"
@import "~/.config/rofi/card.rasi"

window { width: 3000px; height: 1500px; }

mainbox { children: [ listview ]; }

listview {
    columns: 12;
    fixed-columns: true;
    lines: 8;
}

element {
    orientation: vertical;
    /* 240x174 cell: 7px card-shadow margin, then the 208x142 thumbnail image (196x130 photo
       + 6px of its own shadow on each side, see make-cards.py), so the photo has 15px of
       card around it. The icon box is square, so a negative vertical margin trims it to the
       image's 142px height. Rofi can't move content on selection, so the selected card grows
       around it instead of lifting. */
    padding: 16px 16px;
    background-image: url("/home/shubham/.cache/wal/rofi-card-wall.png", both);
}

element selected {
    background-image: url("/home/shubham/.cache/wal/rofi-card-wall-sel.png", both);
}

element-icon { size: 208px; margin: -33px 0px; horizontal-align: 0.5; }
element-text { enabled: false; }
