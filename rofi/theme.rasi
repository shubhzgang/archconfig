@import "~/.cache/wal/colors-rofi.rasi"

* {
    font: "CodeNewRoman Nerd Font Mono 14";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 80%;
    height: 80%;
    padding: 12px;
    border: 3px;
    border-color: @accent;
    border-radius: 10px;
    background-color: @bg;
}

mainbox {
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 14px;
    border-radius: 8px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search";
    placeholder-color: @fg-dim;
}

listview {
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 8px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 1.4em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

/* Gradient window background, same colors as the waybar side sections. Last so it wins. */
@import "~/.cache/wal/colors-rofi-bar.rasi"
